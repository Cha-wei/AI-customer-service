DATABASE_URL="file:./dev.db"
INTENT_PROVIDER="rule"
# Set these only in local .env when opting into OpenAI intent classification.
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_TIMEOUT_MS="15000"
# Use INTENT_PROVIDER=deepseek to opt into DeepSeek instead of OpenAI.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_TIMEOUT_MS="30000"
# Required for /api/internal routes. Configure locally, never commit real tokens.
# JSON array of {"token":"<32+ random characters>","role":"customer","customerId":"customer-1"}
# or {"token":"<different 32+ random characters>","role":"operator"}.
INTERNAL_API_TOKENS=""
