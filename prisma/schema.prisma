generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RevokedCustomerSession {
  digest String @id
  expiresAt DateTime
  @@index([expiresAt])
}

model Conversation {
  id         String    @id @default(cuid())
  customerId String
  status     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]
  executions RuntimeExecution[]
  approvals Approval[]

  @@index([customerId])
  @@index([updatedAt])
  @@index([updatedAt, id])
  @@index([status, updatedAt, id])
  @@index([customerId, updatedAt, id])
}

model Approval {
  id String @id @default(cuid())
  conversationId String
  executionId String @unique
  customerId String
  orderId String
  reason String
  status String @default("pending")
  result String?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model MockRefund {
  id String @id
  customerId String
  orderId String
  approvalId String @unique
  createdAt DateTime @default(now())
  @@unique([customerId, orderId])
}

model RuntimeExecution {
  id             String @id @default(cuid())
  conversationId String
  messageId      String @unique
  status         String
  toolResult     String?
  errorCode      String?
  createdAt      DateTime @default(now())
  finishedAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([conversationId, createdAt, id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
}
